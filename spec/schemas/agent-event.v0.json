{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openagentcore.dev/spec/schemas/agent-event.v0.json",
  "title": "OpenAgentCore AgentEvent v0",
  "oneOf": [
    { "$ref": "#/$defs/turnStarted" },
    { "$ref": "#/$defs/stepStarted" },
    { "$ref": "#/$defs/stepFinished" },
    { "$ref": "#/$defs/modelRequest" },
    { "$ref": "#/$defs/modelDelta" },
    { "$ref": "#/$defs/toolCall" },
    { "$ref": "#/$defs/toolResult" },
    { "$ref": "#/$defs/permissionRequested" },
    { "$ref": "#/$defs/permissionResolved" },
    { "$ref": "#/$defs/compactionApplied" },
    { "$ref": "#/$defs/checkpointCreated" },
    { "$ref": "#/$defs/turnFinished" }
  ],
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "jsonValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/jsonValue" }
        },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/jsonValue" }
        }
      ]
    },
    "jsonObject": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/jsonValue" }
    },
    "baseEvent": {
      "type": "object",
      "required": ["type", "seq", "tenantId", "sessionId", "ts"],
      "properties": {
        "type": { "type": "string" },
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "tenantId": { "$ref": "#/$defs/nonEmptyString" },
        "sessionId": { "$ref": "#/$defs/nonEmptyString" },
        "ts": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "userInput": {
      "type": "object",
      "required": ["content"],
      "properties": {
        "content": { "type": "string" }
      },
      "additionalProperties": false
    },
    "modelCost": {
      "type": "object",
      "required": ["amount", "currency"],
      "properties": {
        "amount": {
          "type": "number",
          "minimum": 0
        },
        "currency": { "$ref": "#/$defs/nonEmptyString" }
      },
      "additionalProperties": false
    },
    "modelUsage": {
      "type": "object",
      "required": ["inputTokens", "outputTokens", "totalTokens"],
      "properties": {
        "inputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "outputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "totalTokens": {
          "type": "integer",
          "minimum": 0
        },
        "cost": { "$ref": "#/$defs/modelCost" }
      },
      "additionalProperties": false
    },
    "textOrToolDelta": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "text"],
          "properties": {
            "kind": { "const": "text" },
            "text": { "type": "string" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "toolCallDelta"],
          "properties": {
            "kind": { "const": "tool" },
            "toolCallDelta": { "$ref": "#/$defs/jsonValue" }
          },
          "additionalProperties": false
        }
      ]
    },
    "eventRange": {
      "type": "object",
      "description": "An inclusive range whose ordering and compaction-event bound are replay invariants.",
      "required": ["fromSeq", "toSeq"],
      "properties": {
        "fromSeq": {
          "type": "integer",
          "minimum": 0
        },
        "toSeq": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "turnStarted": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/baseEvent" },
        {
          "type": "object",
          "required": ["turnId", "input"],
          "properties": {
            "type": { "const": "turn.started" },
            "turnId": { "$ref": "#/$defs/nonEmptyString" },
            "input": { "$ref": "#/$defs/userInput" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "stepStarted": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/baseEvent" },
        {
          "type": "object",
          "required": ["turnId", "stepId", "stepIndex", "injectedInputs"],
          "properties": {
            "type": { "const": "step.started" },
            "turnId": { "$ref": "#/$defs/nonEmptyString" },
            "stepId": { "$ref": "#/$defs/nonEmptyString" },
            "stepIndex": {
              "type": "integer",
              "minimum": 1
            },
            "injectedInputs": {
              "type": "array",
              "items": { "$ref": "#/$defs/userInput" }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "stepFinished": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/baseEvent" },
        {
          "type": "object",
          "required": ["turnId", "stepId", "outcome", "usage"],
          "properties": {
            "type": { "const": "step.finished" },
            "turnId": { "$ref": "#/$defs/nonEmptyString" },
            "stepId": { "$ref": "#/$defs/nonEmptyString" },
            "outcome": {
              "enum": ["succeeded", "failed", "aborted"]
            },
            "usage": { "$ref": "#/$defs/modelUsage" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "modelRequest": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/baseEvent" },
        {
          "type": "object",
          "required": ["stepId", "assembled"],
          "properties": {
            "type": { "const": "model.request" },
            "stepId": { "$ref": "#/$defs/nonEmptyString" },
            "assembled": { "$ref": "#/$defs/jsonObject" },
            "requestId": { "$ref": "#/$defs/nonEmptyString" },
            "toolUse": {
              "enum": ["native", "prompted", "none"]
            },
            "capabilityDowngrades": {
              "type": "array",
              "items": { "$ref": "#/$defs/nonEmptyString" }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "modelDelta": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/baseEvent" },
        {
          "type": "object",
          "required": ["stepId", "delta"],
          "properties": {
            "type": { "const": "model.delta" },
            "stepId": { "$ref": "#/$defs/nonEmptyString" },
            "delta": { "$ref": "#/$defs/textOrToolDelta" },
            "requestId": { "$ref": "#/$defs/nonEmptyString" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "toolCall": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/baseEvent" },
        {
          "type": "object",
          "required": ["callId", "tool", "args"],
          "properties": {
            "type": { "const": "tool.call" },
            "callId": { "$ref": "#/$defs/nonEmptyString" },
            "tool": { "$ref": "#/$defs/nonEmptyString" },
            "args": { "$ref": "#/$defs/jsonValue" },
            "stepId": { "$ref": "#/$defs/nonEmptyString" },
            "modelUsage": { "$ref": "#/$defs/modelUsage" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "toolResult": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/baseEvent" },
        {
          "type": "object",
          "required": ["callId", "result"],
          "properties": {
            "type": { "const": "tool.result" },
            "callId": { "$ref": "#/$defs/nonEmptyString" },
            "result": { "$ref": "#/$defs/jsonValue" },
            "stepId": { "$ref": "#/$defs/nonEmptyString" },
            "outcome": {
              "enum": ["succeeded", "failed", "denied"]
            },
            "error": { "$ref": "#/$defs/jsonValue" },
            "attempts": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "permissionRequested": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/baseEvent" },
        {
          "type": "object",
          "required": ["reqId", "action"],
          "properties": {
            "type": { "const": "permission.requested" },
            "reqId": { "$ref": "#/$defs/nonEmptyString" },
            "action": { "$ref": "#/$defs/jsonObject" },
            "stepId": { "$ref": "#/$defs/nonEmptyString" },
            "callId": { "$ref": "#/$defs/nonEmptyString" },
            "reason": { "$ref": "#/$defs/nonEmptyString" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "permissionResolved": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/baseEvent" },
        {
          "type": "object",
          "required": ["reqId", "decision"],
          "properties": {
            "type": { "const": "permission.resolved" },
            "reqId": { "$ref": "#/$defs/nonEmptyString" },
            "decision": {
              "enum": ["allow", "deny"]
            },
            "stepId": { "$ref": "#/$defs/nonEmptyString" },
            "callId": { "$ref": "#/$defs/nonEmptyString" },
            "reason": { "$ref": "#/$defs/nonEmptyString" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "compactionApplied": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/baseEvent" },
        {
          "type": "object",
          "required": ["summary", "dropped"],
          "properties": {
            "type": { "const": "compaction.applied" },
            "summary": { "type": "string" },
            "strategy": { "type": "string", "minLength": 1 },
            "dropped": { "$ref": "#/$defs/eventRange" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "checkpointCreated": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/baseEvent" },
        {
          "type": "object",
          "required": ["snapshotRef"],
          "properties": {
            "type": { "const": "checkpoint.created" },
            "snapshotRef": { "$ref": "#/$defs/nonEmptyString" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "turnFinished": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/baseEvent" },
        {
          "type": "object",
          "required": ["turnId", "stopReason"],
          "properties": {
            "type": { "const": "turn.finished" },
            "turnId": { "$ref": "#/$defs/nonEmptyString" },
            "stopReason": { "$ref": "#/$defs/nonEmptyString" },
            "usage": { "$ref": "#/$defs/modelUsage" }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
