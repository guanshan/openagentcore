{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "useUnknownInCatchVariables": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@openagentcore/kernel": ["packages/kernel/src/index.ts"],
      "@openagentcore/cli": ["packages/cli/src/index.ts"],
      "@openagentcore/coding": ["packages/coding/src/index.ts"],
      "@openagentcore/standard": ["providers/standard/src/index.ts"],
      "@openagentcore/standard/model": ["providers/standard/src/model/index.ts"],
      "@openagentcore/standard/sandbox": ["providers/standard/src/sandbox/index.ts"],
      "@openagentcore/standard/store": ["providers/standard/src/store/index.ts"],
      "@openagentcore/standard/trace": ["providers/standard/src/trace/index.ts"],
      "@openagentcore/standard/vault": ["providers/standard/src/vault/index.ts"],
      "@openagentcore/tencent": ["providers/tencent/src/index.ts"],
      "@openagentcore/tencent/model": ["providers/tencent/src/model/index.ts"],
      "@openagentcore/tencent/sandbox": ["providers/tencent/src/sandbox/index.ts"],
      "@openagentcore/tencent/trace": ["providers/tencent/src/trace/index.ts"]
    }
  }
}
