{
  "name": "@openagentcore/cli",
  "version": "0.1.0",
  "description": "OpenAgentCore command-line tools and provider conformance suites.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "bin": {
    "oac": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run src",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@openagentcore/kernel": "workspace:*",
    "@openagentcore/standard": "workspace:*"
  }
}
